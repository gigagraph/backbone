{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "experimental": {
    "openTelemetry": false
  },
  "disabled_providers": [
    "opencode"
  ],
  "lsp": true,
  "permission": {
    "read": "allow",
    "glob": "allow",
    "task": "allow",
    "skill": "allow",
    "lsp": "allow",
    "question": "allow",
    "websearch": "ask",
    "edit": "ask",
    "bash": "ask",
    "external_directory": "ask",
    "doom_loop": "ask",
  }
}
